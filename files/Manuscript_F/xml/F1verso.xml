  <text>
    <body>
      <div>
        <pb facs="#facs_" n="" xml:id="img_NaN"/>
        <ab facs="#facs__eSc_dummyblock_">
          <l facs="#facs__eSc_line_1">D</hi>Ie coninc peynsde in <choice><abbr>sinē<g ref="#bar"/></abbr><expan>sine<ex>n</ex></expan></choice> moet</l>
          <l facs="#facs__eSc_line_2">D</hi>ese es te wapene goet</l>
          <l facs="#facs__eSc_line_3">S</hi>al ic liden mijns namen</l>
          <l facs="#facs__eSc_line_4">I</hi>c souts mi ewelic scamen</l>
          <l facs="#facs__eSc_line_5">N</hi>emmermeer en ghecreech ic eere</l>
          <l facs="#facs__eSc_line_6">D</hi>oe sloech hi enen slach soe seere</l>
          <l facs="#facs__eSc_line_7">O</hi>pten swaerten die voer hem hielt</l>
          <l facs="#facs__eSc_line_8">D</hi>at hien manlic hadde gheuelt</l>
          <l facs="#facs__eSc_line_9">E</hi>nde vanden ors tumelen dede</l>
          <l facs="#facs__eSc_line_10">T</hi>usschē<g ref="#bar"/></abbr><expan><hi rend="capitalsize1">T</hi>ussche<ex>n</ex></expan></choice> hem <choice><abbr>beidē<g ref="#bar"/></abbr><expan>beide<ex>n</ex></expan></choice> was ghene vrede</l>
          <l facs="#facs__eSc_line_11">E</hi>nde die swaerte sloech <choice><abbr>optē<g ref="#bar"/></abbr><expan>opte<ex>n</ex></expan></choice> heere</l>
          <l facs="#facs__eSc_line_12">E</hi>nde sloech enen slach soe seere</l>
          <l facs="#facs__eSc_line_13">O</hi>pten helm dat hi boech</l>
          <l facs="#facs__eSc_line_14">E</hi>nde swaert in twe stucken vloech</l>
          <l facs="#facs__eSc_line_15">S</hi>oe anxtelic was die slach</l>
          <l facs="#facs__eSc_line_16">A</hi>ls dat die swerte sach</l>
          <l facs="#facs__eSc_line_17">D</hi>atti sijn swaert had verloren</l>
          <l facs="#facs__eSc_line_18">T</hi>fy was ic ye gheboren</l>
        </ab>
      </div>
    </body>
  </text>
