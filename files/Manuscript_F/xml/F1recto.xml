  <text>
    <body>
      <div>
        <pb facs="#facs_" n="" xml:id="img_NaN"/>
        <ab facs="#facs__eSc_dummyblock_">
          <l facs="#facs__eSc_line_1">Soe dat die coninc was in vare</l>
          <l facs="#facs__eSc_line_2">Ende waende dat die duuel ware</l>
          <l facs="#facs__eSc_line_3">Hi sloech ten swerten opten schilt</l>
          <l facs="#facs__eSc_line_4">Dien hi manlic voer hem hilt</l>
          <l facs="#facs__eSc_line_5">Datti in tween stucken vloech</l>
          <l facs="#facs__eSc_line_6">Oft ware een linden loef</l>
          <l facs="#facs__eSc_line_7">Die swerte sloech den coninc weder</l>
          <l facs="#facs__eSc_line_8">Die swerde ghinghen op ende neder</l>
          <l facs="#facs__eSc_line_9">Opten helme op die maelgien</l>
          <l facs="#facs__eSc_line_10">Datter menich moeste faelgien</l>
          <l facs="#facs__eSc_line_11">Daer <choice><abbr>ē<g ref="#bar"/></abbr><expan>e<ex>n</ex></expan></choice> was halsberch <choice><abbr>gheē<g ref="#bar"/></abbr><expan>ghee<ex>n</ex></expan></choice> so goet</l>
          <l facs="#facs__eSc_line_12">Daer en dranc dore dat bloet</l>
          <l facs="#facs__eSc_line_13">Doer die maelgien vter huut</l>
          <l facs="#facs__eSc_line_14">Daer van sloghen groet gheluut</l>
          <l facs="#facs__eSc_line_15">Die <choice><abbr>spaenderē<g ref="#bar"/></abbr><expan>spaendere<ex>n</ex></expan></choice> <choice><abbr>vā<g ref="#bar"/>dē<g ref="#bar"/></abbr><expan>va<ex>n</ex>de<ex>n</ex></expan></choice> scilt <choice><abbr>d'<g ref="#apomod"/></abbr><expan>d<ex>aer</ex></expan></choice> vloghen</l>
          <l facs="#facs__eSc_line_16">Die <choice><abbr>helmē<g ref="#bar"/></abbr><expan>helme<ex>n</ex></expan></choice> op haer hoeft die <choice><abbr>boghē<g ref="#bar"/></abbr><expan>boghe<ex>n</ex></expan></choice</l>
          <l facs="#facs__eSc_line_17"><choice><abbr>En̄<g ref="#bar"/></abbr><expan><hi rend="capitalsize1">En<ex>de</ex></expan></choice> ontfinghen scaerde <choice><abbr>en̄<g ref="#bar"/></abbr><expan>en<ex>de</ex></expan></choice> <choice><abbr>vlegghē<g ref="#bar"/></abbr><expan>vlegghe<ex>n</ex></expan></choice></l>
          <l facs="#facs__eSc_line_18">Soe scarp <choice><abbr>warē<g ref="#bar"/></abbr><expan>ware<ex>n</ex></expan></choice> der <choice><abbr>swaerdē<g ref="#bar"/></abbr><expan>swaerde<ex>n</ex></expan></choice> <choice><abbr>egghē<g ref="#bar"/></abbr><expan>egghe<ex>n</ex></expan></choice></l>
        </ab>
      </div>
    </body>
